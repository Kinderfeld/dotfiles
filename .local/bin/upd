__os__="devuan"

printf "updating the system...\n"

if [ -x "/usr/bin/morpheus" ] || [ -x "${HOME}/.local/bin/morpheus" ]
then
    morpheus -PM update && morpheus -PM upgrade
    exit 0
else
    case "${__os__}" in
        "alpine") apk update && apk upgrade ;;
        "arch" | "artix") pacman -Syu --noconfirm ;;
        "ubuntu" | "debian" | "devuan") apt update && apt upgrade -y ;;
        "freebsd" | "hardenedbsd" | "ghostbsd") pkg update && pkg upgrade -y ;;
        *) printf "unknown os: %s." "${__os__}" >&2
    esac
fi

printf "done.\n"

