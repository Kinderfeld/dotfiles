printf "=== SUID/SGID FILE AUDIT ===\n\n"

doas find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -print0 2>/dev/null |
while IFS= read -r -d "" file
do
    perms="$(ls -ld "${file}" 2>/dev/null | awk '{print $1}')"
    owner="$(stat -c '%U:%G' "${file}" 2>/dev/null)"
    package="$(dpkg-query -S "${file}" 2>/dev/null)"

    printf '%-65s %-12s %-20s' "${file}" "${perms}" "${owner}"

    if [ -n "${package}" ]
    then
        printf "    %s\n" "${package}"
    else
        printf "    [NOT OWNED BY A PACKAGE]\n"
    fi
done

printf "\n\n === END OF AUDIT ===\n"

